# MongoDB Atlas (cloud) — lấy chuỗi kết nối tại: Atlas > Database > Connect > Drivers
# Thay <user>, <password>, <cluster> bằng giá trị thật; nếu password có ký tự đặc biệt thì phải URL-encode
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dudi-demo?retryWrites=true&w=majority
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
FRONTEND_URL=http://localhost:5173

# Gửi OTP khi đăng ký bằng SĐT
# console: không gửi SMS thật, mã in ra log server (khi chạy ở máy còn hiện trên form để test)
# twilio: gửi SMS thật, cần 3 biến TWILIO_* bên dưới
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Firebase Auth (SĐT + Facebook): chỉ cần Project ID để kiểm tra token (không cần service account)
FIREBASE_PROJECT_ID=
